{
  "name": "portfolio",
  "version": "1.0.0",
  "description": "This is my final project for the Responsive Web Design Certification on freeCodeCamp. The goal was to build a personal portfolio that showcases a few of my projects, includes smooth navigation, and is responsive across screen sizes.",
  "main": "index.js",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "dev:legacy": "concurrently \"npm run dev:legacy:client\" \"npm run dev:legacy:api\"",
    "dev:legacy:client": "npm run dev --prefix client",
    "dev:legacy:api": "npm run dev --prefix api",
    "build:legacy": "npm install --prefix client && npm install --prefix api && npm run build --prefix client && mkdir -p dist && cp -r client/dist/* dist/",
    "client": "npm run dev:legacy:client",
    "api": "npm run dev:legacy:api",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/edenjermendi/portfolio.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/edenjermendi/portfolio/issues"
  },
  "homepage": "https://edenjermendi.com",
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.2.10",
    "ts-node-dev": "^2.0.0",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "codex": "^0.2.3",
    "express": "^5.2.1",
    "next": "^16.2.10",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  }
}
